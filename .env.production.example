# ====== Django core ======
# Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*

# The external Docker network pg_container is on (discover with:
#   docker inspect pg_container --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}')
EXTERNAL_NETWORK=bridge

# ====== Database (shared pg_container) ======
DB_NAME=entreprises_db
DB_USER=postgres
DB_PASSWORD=changeme          # real POSTGRES_PASSWORD of pg_container
DB_HOST=pg_container
DB_PORT=5432

# ====== JWT ======
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ====== Frontend origin (for CORS / CSRF on the demo) ======
# Same-origin via nginx proxy, so list the host:port the browser uses.
CORS_ALLOWED_ORIGINS=http://51.75.120.255:8080
CSRF_TRUSTED_ORIGINS=http://51.75.120.255:8080

# ====== Optional: bootstrap a demo admin ======
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ====== Email (console backend = fine for demo) ======
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
